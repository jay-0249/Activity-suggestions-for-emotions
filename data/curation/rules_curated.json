{
  "_comment": "Machine-evaluable encoding of matching rules R01-R30. Text fields (condition, recommended, avoid, rationale, citation, doi_or_url, evidence basis) are parsed from the notes table by the build script; this file adds only the structured condition, the class lists and explicit activity ids. 'Happy' in the notes = taxonomy id 'content'; 'excited' = 'energetic'. Thresholds 0.4 / 0.75 / 0.9 are uncalibrated engineering defaults.",
  "class_definitions": {
    "BREATHE": "slow breathing, muscle relaxation",
    "MINDFUL": "meditation, grounding",
    "SENSORY": "cold water, warm shower, senses-based grounding",
    "MOVE-LOW": "stretching, gentle yoga, easy walk",
    "MOVE-MOD": "self-paced brisk walk, run, sport, dancing",
    "NATURE": "nature",
    "MUSIC": "music",
    "DISTRACT": "absorbing game, puzzle, show, hobby",
    "PLEASANT": "planned enjoyable or mastery activity = behavioural activation",
    "SOCIAL": "call, message, meet someone",
    "REAPPRAISE": "perspective-taking, journalling",
    "PLAN": "problem-solving, to-do triage",
    "REST": "break, nap, wind-down",
    "CHALLENGE": "creative or skill task",
    "SAVOR": "gratitude, savouring",
    "SHARE": "tell someone good news",
    "KIND": "do something for someone"
  },
  "class_to_category": {
    "BREATHE": ["mind-body"], "MINDFUL": ["mind-body"], "SENSORY": ["mind-body", "rest"], "MOVE-LOW": ["physical", "mind-body"],
    "MOVE-MOD": ["physical"], "NATURE": ["nature"], "MUSIC": ["creative"], "DISTRACT": ["play", "creative", "rest"],
    "PLEASANT": ["creative", "cognitive"], "SOCIAL": ["social"], "REAPPRAISE": ["cognitive"], "PLAN": ["cognitive"],
    "REST": ["rest"], "CHALLENGE": ["play", "creative"], "SAVOR": ["cognitive"], "SHARE": ["social"], "KIND": ["social"]
  },
  "restless_fallback": {
    "recommend_classes": ["MOVE-LOW", "BREATHE", "NATURE", "MOVE-MOD", "DISTRACT"],
    "avoid_activity_ids": ["passive_scrolling", "dwelling_on_feelings"],
    "note": "The notes contain NO single-emotion rule for 'restless' and no evidence rows targeting it. This fallback is a judgement call made in this dataset build (high-arousal-negative quadrant principle plus R18's direction), marked extrapolated."
  },
  "matrix_extra_pairs": [["content", "energetic"], ["calm", "content"], ["content", "tired"], ["content", "sad"], ["energetic", "anxious"], ["content", "stressed"]],
  "rules": {
    "R01": {"rule_type": "intensity_modifier", "priority": 90,
      "condition": {"any": [{"group": "negative", "gte": 0.75}]},
      "recommend_classes": ["BREATHE", "SENSORY", "DISTRACT", "MOVE-LOW"], "follow_up_classes": ["REAPPRAISE", "PLAN", "SOCIAL"],
      "avoid_first_classes": ["REAPPRAISE"], "avoid_activity_ids": ["dwelling_on_feelings"],
      "app_note": "Restricts the FIRST suggestion to these classes; cognitive or social options are offered as the follow-up."},
    "R02": {"rule_type": "intensity_modifier", "priority": 10,
      "condition": {"all": [{"group": "negative", "gte": 0.4}, {"group": "negative", "lt": 0.75}]},
      "recommend_classes": ["REAPPRAISE", "PLAN"], "avoid_activity_ids": [],
      "app_note": "Adds REAPPRAISE and PLAN to whatever the emotion's own rule allows. 'Suppressing the feeling' has no activity id; never prompt it."},
    "R03": {"rule_type": "single", "priority": 40, "single_emotion": "angry",
      "condition": {"all": [{"emotion": "angry", "gte": 0.4}]},
      "recommend_classes": ["BREATHE", "MINDFUL", "MOVE-LOW", "REAPPRAISE"],
      "avoid_activity_ids": ["venting", "running_jogging", "vigorous_exercise", "hiit", "dwelling_on_feelings"]},
    "R04": {"rule_type": "single", "priority": 40, "single_emotion": "stressed",
      "condition": {"all": [{"emotion": "stressed", "gte": 0.4, "lt": 0.75}]},
      "recommend_classes": ["BREATHE", "MOVE-MOD", "MOVE-LOW", "MUSIC", "NATURE", "PLAN", "REAPPRAISE"],
      "avoid_activity_ids": ["passive_scrolling"],
      "ask_user": {"question": "Is this something you can do something about right now?", "yes": ["PLAN"], "no": ["REAPPRAISE"]},
      "app_note": "At stressed >= 0.75 the single-emotion lookup still uses this rule, with R01 gating the first suggestion. Comfort eating and alcohol are never suggested."},
    "R05": {"rule_type": "single", "priority": 40, "single_emotion": "anxious",
      "condition": {"all": [{"emotion": "anxious", "gte": 0.4}]},
      "recommend_classes": ["BREATHE", "MINDFUL", "MOVE-LOW", "MOVE-MOD", "REAPPRAISE"],
      "avoid_activity_ids": ["caffeine_nap"]},
    "R06": {"rule_type": "single", "priority": 40, "single_emotion": "sad",
      "condition": {"all": [{"emotion": "sad", "gte": 0.4}]},
      "recommend_classes": ["PLEASANT", "MOVE-MOD", "SOCIAL", "MUSIC"],
      "avoid_activity_ids": ["sad_music_listening", "dwelling_on_feelings", "passive_scrolling"]},
    "R07": {"rule_type": "single", "priority": 40, "single_emotion": "tired",
      "condition": {"all": [{"emotion": "tired", "gte": 0.4}]},
      "recommend_classes": ["REST", "MOVE-LOW", "MUSIC", "NATURE"],
      "avoid_classes": ["CHALLENGE"], "avoid_effort": ["high"], "avoid_activity_ids": []},
    "R08": {"rule_type": "single", "priority": 40, "single_emotion": "bored",
      "condition": {"all": [{"emotion": "bored", "gte": 0.4}]},
      "recommend_classes": ["CHALLENGE", "KIND", "SOCIAL"], "use_user_hobbies": true,
      "avoid_activity_ids": ["passive_scrolling", "dwelling_on_feelings"]},
    "R09": {"rule_type": "single", "priority": 40, "single_emotion": "lonely",
      "condition": {"all": [{"emotion": "lonely", "gte": 0.4}]},
      "recommend_classes": ["SOCIAL", "KIND", "REAPPRAISE"],
      "avoid_activity_ids": ["passive_scrolling"]},
    "R10": {"rule_type": "pair", "priority": 60, "pair": ["stressed", "tired"],
      "condition": {"all": [{"emotion": "stressed", "gte": 0.4}, {"emotion": "tired", "gte": 0.4}]},
      "recommend_classes": ["BREATHE", "MOVE-LOW", "SENSORY", "MUSIC", "REST"], "follow_up_classes": ["PLAN"],
      "avoid_classes": ["MOVE-MOD", "CHALLENGE"], "avoid_effort": ["high"], "avoid_activity_ids": ["caffeine_nap", "upbeat_music_listening"],
      "app_note": "Defer PLAN to 'later, one small step'. Music should be calm."},
    "R11": {"rule_type": "pair", "priority": 60, "pair": ["stressed", "anxious"],
      "condition": {"all": [{"emotion": "stressed", "gte": 0.4}, {"emotion": "anxious", "gte": 0.4}]},
      "recommend_classes": ["BREATHE", "MINDFUL", "MOVE-LOW", "MOVE-MOD"], "follow_up_classes": ["PLAN", "REAPPRAISE"],
      "avoid_activity_ids": ["caffeine_nap"],
      "ask_user": {"question": "Is this something you can do something about right now?", "yes": ["PLAN"], "no": ["REAPPRAISE"]}},
    "R12": {"rule_type": "pair", "priority": 60, "pair": ["anxious", "lonely"],
      "condition": {"all": [{"emotion": "anxious", "gte": 0.4}, {"emotion": "lonely", "gte": 0.4}]},
      "recommend_classes": ["SOCIAL", "BREATHE", "KIND"],
      "avoid_activity_ids": ["group_singing", "laughter_exercises", "dwelling_on_feelings"], "avoid_effort": ["high"],
      "app_note": "SOCIAL must be in a low-demand form (text a trusted person, co-walk). BREATHE first if intensity is high."},
    "R13": {"rule_type": "pair", "priority": 60, "pair": ["angry", "sad"],
      "condition": {"all": [{"emotion": "angry", "gte": 0.4}, {"emotion": "sad", "gte": 0.4}]},
      "recommend_classes": ["BREATHE", "MINDFUL", "REAPPRAISE", "SOCIAL", "MUSIC"],
      "avoid_activity_ids": ["venting", "vigorous_exercise", "hiit", "running_jogging", "sad_music_listening", "drawing_to_vent"],
      "app_note": "Sequence matters: calm first, then journalling or reappraisal, then talk to a supportive person."},
    "R14": {"rule_type": "pair", "priority": 60, "pair": ["angry", "stressed"],
      "condition": {"all": [{"emotion": "angry", "gte": 0.4}, {"emotion": "stressed", "gte": 0.4}]},
      "recommend_classes": ["BREATHE", "MOVE-LOW", "NATURE"], "follow_up_classes": ["PLAN"],
      "avoid_classes": ["MOVE-MOD"], "avoid_activity_ids": ["venting", "vigorous_exercise", "hiit", "running_jogging"],
      "app_note": "Keep movement easy or playful. Do not prompt sending messages while angry."},
    "R15": {"rule_type": "pair", "priority": 60, "pair": ["sad", "tired"],
      "condition": {"all": [{"emotion": "sad", "gte": 0.4}, {"emotion": "tired", "gte": 0.4}]},
      "recommend_classes": ["PLEASANT", "MOVE-LOW", "MUSIC", "SOCIAL", "REST"],
      "avoid_effort": ["high"], "max_typical_duration_min": 20, "avoid_activity_ids": ["sad_music_listening", "dwelling_on_feelings"],
      "app_note": "Very small step (5-10 min); low-effort social form (voice note); REST if sleep-deprived. max_typical_duration_min = 20 is this build's encoding of 'very small step'."},
    "R16": {"rule_type": "pair", "priority": 60, "pair": ["sad", "lonely"],
      "condition": {"all": [{"emotion": "sad", "gte": 0.4}, {"emotion": "lonely", "gte": 0.4}]},
      "recommend_classes": ["SOCIAL", "KIND", "PLEASANT"],
      "avoid_activity_ids": ["passive_scrolling", "sad_music_listening", "dwelling_on_feelings"]},
    "R17": {"rule_type": "pair", "priority": 60, "pair": ["anxious", "sad"],
      "condition": {"all": [{"emotion": "anxious", "gte": 0.4}, {"emotion": "sad", "gte": 0.4}]},
      "recommend_classes": ["MOVE-MOD", "PLEASANT", "MINDFUL", "SOCIAL"], "follow_up_classes": ["REAPPRAISE"],
      "avoid_activity_ids": ["dwelling_on_feelings", "sad_music_listening", "caffeine_nap"]},
    "R18": {"rule_type": "pair", "priority": 60, "pair": ["bored", "restless"],
      "condition": {"all": [{"emotion": "bored", "gte": 0.4}, {"emotion": "restless", "gte": 0.4}]},
      "recommend_classes": ["MOVE-MOD", "CHALLENGE", "NATURE"],
      "avoid_first_classes": ["MINDFUL"], "avoid_activity_ids": ["passive_scrolling", "dwelling_on_feelings"],
      "app_note": "Sitting meditation should not be the first option."},
    "R19": {"rule_type": "pair", "priority": 60, "pair": ["bored", "lonely"],
      "condition": {"all": [{"emotion": "bored", "gte": 0.4}, {"emotion": "lonely", "gte": 0.4}]},
      "recommend_classes": ["SOCIAL", "KIND", "CHALLENGE"],
      "avoid_activity_ids": ["passive_scrolling", "dwelling_on_feelings"],
      "app_note": "Prefer one activity that supplies both engagement and connection (game with a friend, class, club)."},
    "R20": {"rule_type": "pair", "priority": 60, "pair": ["bored", "tired"],
      "condition": {"all": [{"emotion": "bored", "gte": 0.4}, {"emotion": "tired", "gte": 0.4}]},
      "recommend_classes": ["REST", "MUSIC", "MOVE-LOW"], "extra_activity_ids": ["colouring_structured", "drawing_something_happy"],
      "avoid_classes": ["CHALLENGE"], "avoid_effort": ["high"], "avoid_activity_ids": ["caffeine_nap", "passive_scrolling"],
      "app_note": "Check whether the 'boredom' is fatigue: rest first, then light novelty. extra_activity_ids stand for the notes' 'easy creative task'."},
    "R21": {"rule_type": "pair", "priority": 60, "pair": ["anxious", "tired"],
      "condition": {"all": [{"emotion": "anxious", "gte": 0.4}, {"emotion": "tired", "gte": 0.4}]},
      "recommend_classes": ["BREATHE", "MINDFUL", "MOVE-LOW", "REST", "MUSIC"],
      "avoid_classes": ["MOVE-MOD", "PLAN"], "avoid_effort": ["high"], "avoid_activity_ids": ["caffeine_nap", "hiit", "vigorous_exercise", "upbeat_music_listening"],
      "app_note": "Body scan / muscle relaxation; wind-down routine; calm music. PLAN is avoided here because the notes say no problem-solving in bed."},
    "R22": {"rule_type": "pair", "priority": 60, "pair": ["stressed", "sad"],
      "condition": {"all": [{"emotion": "stressed", "gte": 0.4}, {"emotion": "sad", "gte": 0.4}]},
      "recommend_classes": ["MOVE-MOD", "NATURE", "SOCIAL", "PLEASANT"], "follow_up_classes": ["PLAN", "REAPPRAISE"],
      "avoid_activity_ids": ["dwelling_on_feelings", "sad_music_listening", "passive_scrolling"],
      "ask_user": {"question": "Is this something you can do something about right now?", "yes": ["PLAN"], "no": ["REAPPRAISE"]}},
    "R23": {"rule_type": "pair", "priority": 60, "pair": ["stressed", "lonely"],
      "condition": {"all": [{"emotion": "stressed", "gte": 0.4}, {"emotion": "lonely", "gte": 0.4}]},
      "recommend_classes": ["SOCIAL", "MOVE-LOW", "BREATHE"],
      "avoid_activity_ids": ["passive_scrolling"],
      "app_note": "MOVE-LOW here stands for the notes' 'co-walk' (walk with someone)."},
    "R24": {"rule_type": "pair", "priority": 60, "pair": ["content", "energetic"],
      "condition": {"all": [{"emotion": "content", "gte": 0.4}, {"emotion": "energetic", "gte": 0.4}]},
      "recommend_classes": ["CHALLENGE", "MOVE-MOD", "SHARE", "KIND"],
      "avoid_activity_ids": ["dampening_positive"],
      "app_note": "Nothing to avoid; do not push calming activities."},
    "R25": {"rule_type": "pair", "priority": 60, "pair": ["calm", "content"],
      "condition": {"all": [{"emotion": "calm", "gte": 0.4}, {"emotion": "content", "gte": 0.4}]},
      "recommend_classes": ["SAVOR", "MINDFUL", "NATURE"], "extra_activity_ids": ["colouring_structured", "knitting", "drawing_something_happy"],
      "avoid_effort": ["high"], "avoid_activity_ids": ["dampening_positive"],
      "app_note": "extra_activity_ids stand for the notes' 'gentle creative hobby'. Also used as the default when no emotion is active (neutral)."},
    "R26": {"rule_type": "pair", "priority": 60, "pair": ["content", "tired"],
      "condition": {"all": [{"emotion": "content", "gte": 0.4}, {"emotion": "tired", "gte": 0.4}]},
      "recommend_classes": ["SAVOR", "SHARE", "REST", "MUSIC"],
      "avoid_classes": ["CHALLENGE"], "avoid_effort": ["high"], "avoid_activity_ids": ["dampening_positive", "upbeat_music_listening"]},
    "R27": {"rule_type": "pair_group", "priority": 50,
      "condition": {"all": [{"group": "positive", "gte": 0.4}, {"group": "negative", "gte": 0.4}]},
      "recommend_classes": ["SHARE", "MUSIC"], "extra_activity_ids": ["affect_labeling", "journaling"],
      "conditional_classes": [{"when": {"all": [{"emotion": "energetic", "gte": 0.4}, {"emotion": "anxious", "gte": 0.4}]}, "add_classes": ["MOVE-LOW", "BREATHE"]}],
      "avoid_activity_ids": ["dampening_positive", "dwelling_on_feelings"],
      "app_note": "Mixed valence: show both labels, never force a single one. extra_activity_ids stand for 'journalling / naming both feelings'. A specific pair rule (e.g. R26) outranks this one."},
    "R28": {"rule_type": "modifier", "priority": 5,
      "condition": {"all": [{"group": "negative", "gte": 0.4}, {"selected_class": "MUSIC"}]},
      "recommend_classes": ["MUSIC"], "avoid_activity_ids": ["sad_music_listening"],
      "app_note": "Iso principle: start with a track matching the current mood, move toward the target mood over 2-3 tracks; let the user choose the tracks."},
    "R29": {"rule_type": "personalisation", "priority": 1,
      "condition": {"always": true},
      "recommend_classes": [], "avoid_activity_ids": [],
      "app_note": "Rank inside the allowed classes by likes/hobbies and past helpfulness; filter dislikes; show 2-3 choices; rotate for variety. A preference never overrides a rule's avoid list."},
    "R30": {"rule_type": "safety_gate", "priority": 100,
      "condition": {"any": [{"group": "negative", "gte": 0.9}, {"signal": "persistent_severe_negative"}, {"signal": "self_harm_cue"}, {"signal": "severe_self_report"}]},
      "recommend_classes": [], "extra_activity_ids": ["grounding_54321"], "avoid_activity_ids": [],
      "app_note": "Skip the activity list; show the supportive message and localised crisis resources (see safety.json). The grounding exercise is optional. The 0.9 threshold is an uncalibrated precaution, not a screening tool."}
  }
}
